//Approach
Initialize a variable height to 0. This will act as our running sum to track the biker's current height.
Initialize another variable maxi to 0. This will store the highest altitude encountered during the trip.
Iterate through each value in the gain array.
For every step, add the current gain i to height.
Compare height with maxi and update maxi with the larger of the two values.
After the loop finishes, return maxi.
// class Solution {
public:
    int largestAltitude(vector<int>& gain) {
        int n=gain.size();
        int hi=0, alt=0;
        for(int i=0; i<n; i++){
            alt+=gain[i];
            hi=max(hi, alt);
        }
        return hi;
    }
};
