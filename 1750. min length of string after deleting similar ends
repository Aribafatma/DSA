class Solution {
public:
    int minimumLength(string s){

        int i=0;
        int j=s.size()-1;

        if(s[i]!=s[j]) return j+1;
        
        while(i<j && s[i]==s[j]){

            while(i<j && s[i]==s[i+1]){
                i++;
            }

            while(i<j && s[j]==s[j-1]){
                j--;
            }

            i++;j--;

        }

        if(i>j) return 0;
        return j-i+1;

    }
};
