//Brute Force Approach
//A simple way to solve this problem is:Use a string ans to store the result.,Traverse the input string from left to right.
//For a lowercase letter, append it to ans.
//For *, remove the last character if it exists.
//For #, duplicate the current string.
//For %, reverse the current string.
class Solution {
public:
    string processStr(string s) {
        string ans;

        for (char ch : s) {
            if (islower(ch)) {
                ans += ch;
            }
            else if (ch == '*') {
                if (!ans.empty()) {
                    ans.pop_back();
                }
            }
            else if (ch == '#') {
                ans += ans;
            }
            else {
                reverse(ans.begin(), ans.end());
            }
        }

        return ans;
    }
};
