#include <iostream>
#include <vector>

using namespace std;

// Function to find and print all jump sequences
void findPaths(int remaining, int maxJump, vector<int>& currentPath) {
    // Base Case: If we reached exactly step N
    if (remaining == 0) {
        for (int i = 0; i < currentPath.size(); ++i) {
            cout << currentPath[i] << (i == currentPath.size() - 1 ? "" : " ");
        }
        cout << "\n";
        return;
    }

    // Try every possible jump size from 1 to K
    for (int jump = 1; jump <= maxJump; ++jump) {
        if (remaining >= jump) {
            currentPath.push_back(jump);      // Choose
            findPaths(remaining - jump, maxJump, currentPath); // Recurse
            currentPath.pop_back();           // Backtrack
        }
    }
}

int main() {
    int N, K;
    if (!(cin >> N >> K)) return 0;

    vector<int> path;
    findPaths(N, K, path);

    return 0;
}
