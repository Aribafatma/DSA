#include <iostream>
#include <vector>

using namespace std;

int main() {
    // Optimize input and output speed
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int N;
    if (!(cin >> N)) return 0;

    // Use long long to accommodate values up to 10^18
    vector<long long> A(N);
    for (int i = 0; i < N; i++) {
        cin >> A[i];
    }

    long long X;
    cin >> X;

    int position = -1;
    for (int i = 0; i < N; i++) {
        if (A[i] == X) {
            // Found the first occurrence; use 1-based indexing
            position = i + 1;
            break; 
        }
    }

    cout << position << endl;

    return 0;
}
