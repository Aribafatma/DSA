#include <iostream>

using namespace std;

// Recursive function to print numbers from 1 to n
void printIncreasing(int n) {
    // Base Case: Stop when n reaches 0
    if (n == 0) {
        return;
    }

    // Recursive Call: Move towards the base case (1)
    printIncreasing(n - 1);

    // Print the current number after the recursive call returns
    cout << n << "\n";
}

int main() {
    // Optimization for faster I/O
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int N;
    if (cin >> N) {
        printIncreasing(N);
    }

    return 0;
}
