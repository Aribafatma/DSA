#include <iostream>

using namespace std;

int main() {
    // Optimize I/O operations
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int N;
    cin >> N;

    long long sum = 0;
    for (int i = 0; i < N; ++i) {
        long long current_val;
        cin >> current_val;
        sum += current_val;
    }

    cout << sum << endl;

    return 0;
}
